// Cloudflare Workers config for the GreyLeads static website.
{
  "name": "greyleads",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "greyleads.in", "custom_domain": true },
    { "pattern": "www.greyleads.in", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
